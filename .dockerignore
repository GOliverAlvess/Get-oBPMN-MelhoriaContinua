node_modules/

# Ignore local build outputs
dist/
build/

# Ignore local environment files and logs
.env
.env*.local
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Ignore version control systems and documentation
.git/
.github/
.gitignore
.vscode/
README.md
README.docker.md
docker-compose.yml
