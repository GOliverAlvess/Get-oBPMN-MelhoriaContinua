{
  "entities": {
    "User": {
      "title": "User",
      "description": "System users who manage projects",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "sector": { "type": "string" }
      },
      "required": ["id", "name"]
    },
    "Project": {
      "title": "Project",
      "description": "A process management project including BPMN and PDCA",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "progress": { "type": "number" },
        "status": { "type": "string", "enum": ["Planejamento", "Em Execução", "Concluído", "Suspenso"] },
        "priority": { "type": "string", "enum": ["Baixa", "Média", "Alta"] },
        "assignedTo": { "type": "string", "description": "User ID" },
        "scope": { "type": "object" },
        "mapping": { "type": "object" },
        "pdcaCycles": { "type": "array" },
        "savedColors": { "type": "array" }
      },
      "required": ["id", "name", "createdAt", "progress", "status", "assignedTo", "scope", "mapping"]
    },
    "GlobalConfig": {
      "title": "GlobalConfig",
      "description": "Global system configurations like sectors and tools",
      "type": "object",
      "properties": {
        "sectors": { "type": "array", "items": { "type": "string" } },
        "tools": { "type": "array", "items": { "type": "string" } }
      }
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile information"
    },
    "/projects/{projectId}": {
      "schema": "Project",
      "description": "Main project documents"
    },
    "/config/{configId}": {
      "schema": "GlobalConfig",
      "description": "Global configuration settings"
    }
  }
}
